[Unit]
Description=Apply CPU power and frequency limits (thermal fix)
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cpu-thermal-limits.sh apply
# ExecStopPost (not ExecStop) also runs when "apply" failed, so a partial apply is
# rolled back and "systemctl stop" always restores the saved values.
ExecStopPost=/usr/local/sbin/cpu-thermal-limits.sh reset

# Sandboxing: the script only needs to write to /sys and its state directory.
StateDirectory=cpu-thermal-limits
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
