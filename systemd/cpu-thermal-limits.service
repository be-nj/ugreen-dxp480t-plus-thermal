[Unit]
Description=Apply CPU power and frequency limits (thermal fix)
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cpu-thermal-limits.sh apply
# ExecStopPost (not ExecStop) also runs when "apply" failed, so a partial apply is
# rolled back and "systemctl stop" always restores the saved values.
ExecStopPost=/usr/local/sbin/cpu-thermal-limits.sh reset

# Sandboxing: /sys and /proc/sys are read-only except the power limit and cpufreq
# directories; writable state only in /var/lib and /run/cpu-thermal-limits.
StateDirectory=cpu-thermal-limits
RuntimeDirectory=cpu-thermal-limits
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
# Not ProtectKernelTunables=yes: on systemd 257 it leaves /sys writable as soon as
# ReadWritePaths= opens subdirectories of /sys. Explicit read-only paths do work.
ReadOnlyPaths=/sys
ReadOnlyPaths=/proc/sys
ReadOnlyPaths=/proc/sysrq-trigger
ReadWritePaths=-/sys/devices/virtual/powercap/intel-rapl
ReadWritePaths=-/sys/devices/virtual/powercap/intel-rapl-mmio
ReadWritePaths=/sys/devices/system/cpu/cpufreq
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
