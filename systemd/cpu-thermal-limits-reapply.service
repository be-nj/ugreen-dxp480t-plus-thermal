[Unit]
Description=Re-apply CPU power and frequency limits
# Only re-apply while the main service is active. After
# "systemctl stop cpu-thermal-limits.service" the timer must not bring the limits back.
Requisite=cpu-thermal-limits.service
After=cpu-thermal-limits.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cpu-thermal-limits.sh reapply

# Sandboxing: /sys and /proc/sys are read-only except the power limit and cpufreq
# directories; writable state only in /var/lib and /run/cpu-thermal-limits.
StateDirectory=cpu-thermal-limits
RuntimeDirectory=cpu-thermal-limits
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
# Not ProtectKernelTunables=yes: on systemd 257 it leaves /sys writable as soon as
# ReadWritePaths= opens subdirectories of /sys. Explicit read-only paths do work.
ReadOnlyPaths=/sys
ReadOnlyPaths=/proc/sys
ReadOnlyPaths=/proc/sysrq-trigger
ReadWritePaths=-/sys/devices/virtual/powercap/intel-rapl
ReadWritePaths=-/sys/devices/virtual/powercap/intel-rapl-mmio
ReadWritePaths=/sys/devices/system/cpu/cpufreq
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077
