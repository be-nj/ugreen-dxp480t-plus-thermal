[Unit]
Description=Re-apply CPU power and frequency limits

[Service]
Type=oneshot
# Runs the main service's ExecReload, and does nothing if it is not active.
# systemd orders this against a concurrent stop of the main service.
ExecStart=/usr/bin/systemctl try-reload-or-restart cpu-thermal-limits.service

# Sandboxing: only needs to talk to systemd over its local socket.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077
